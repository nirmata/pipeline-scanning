# Option B: Manually generate PolicyException YAML for selected Kubernetes resources using nctl ai.
# Run from Actions → this workflow → "Run workflow".
#
# Resource selectors (comma-separated), examples:
#   Deployment/my-app                    (namespace defaults to "default" if omitted)
#   Deployment/my-ns/my-app              (kind / namespace / name)
#
# Required repository secrets (same as PR scan):
#   NIRMATA_URL, NIRMATA_TOKEN
# Optional: NIRMATA_USERID

name: nctl PolicyException generation (manual)

on:
  workflow_dispatch:
    inputs:
      chart_path:
        description: 'Directory containing the Helm chart (repo root = .)'
        required: false
        default: '.'
      git_ref:
        description: 'Git ref to checkout (branch, tag, or SHA)'
        required: false
        default: ''
      policy_sets:
        description: 'Comma-separated policy sets'
        required: false
        default: 'pss-baseline,pss-restricted'
      resources:
        description: 'Comma-separated resource selectors (see workflow header)'
        required: true
        default: ''
      exception_dir:
        description: 'Output folder for PolicyException YAML files'
        required: false
        default: 'policyexceptions'

env:
  NIRMATA_URL: ${{ secrets.NIRMATA_URL }}
  NIRMATA_TOKEN: ${{ secrets.NIRMATA_TOKEN }}

jobs:
  generate:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    permissions:
      contents: read

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: ${{ inputs.git_ref != '' && inputs.git_ref || github.ref }}

      - name: Install nctl
        uses: nirmata/action-install-nctl-scan@v0.0.12

      - name: Authenticate nctl (optional)
        env:
          NIRMATA_USERID: ${{ secrets.NIRMATA_USERID }}
        run: |
          set -euo pipefail
          if [ -n "${NIRMATA_USERID:-}" ]; then
            nctl login --url "${NIRMATA_URL}" --userid "${NIRMATA_USERID}" --token "${NIRMATA_TOKEN}"
          fi

      - name: Scan Helm (regenerate report)
        working-directory: ${{ inputs.chart_path }}
        run: |
          set -euo pipefail
          nctl scan helm -r . --policy-sets "${{ inputs.policy_sets }}" -o json > report.json

      - name: Filter report to selected resources
        working-directory: ${{ inputs.chart_path }}
        env:
          SELECTORS: ${{ inputs.resources }}
        run: |
          set -euo pipefail
          python3 << 'PY'
          import json
          import os
          import sys

          def parse_selector(s: str):
              s = s.strip()
              if not s:
                  return None
              parts = [p for p in s.split("/") if p]
              if len(parts) == 2:
                  kind, name = parts
                  return kind, "default", name
              if len(parts) == 3:
                  return parts[0], parts[1], parts[2]
              raise ValueError(f"Invalid selector (use Kind/Name or Kind/Namespace/Name): {s!r}")

          def resource_tuple(obj: dict):
              res = obj.get("resource") or obj.get("Resource")
              if not isinstance(res, dict):
                  return None
              kind = res.get("kind") or res.get("Kind")
              md = res.get("metadata") or res.get("Metadata") or {}
              if not isinstance(md, dict):
                  md = {}
              name = md.get("name") or md.get("Name")
              ns = md.get("namespace") or md.get("Namespace") or "default"
              if not kind or not name:
                  return None
              return str(kind), str(ns), str(name)

          def find_result_arrays(data):
              if isinstance(data, dict):
                  for k, v in data.items():
                      if k in ("results", "Results", "items", "Items", "violations", "Violations") and isinstance(v, list):
                          yield v
                      yield from find_result_arrays(v)
              elif isinstance(data, list):
                  for item in data:
                      yield from find_result_arrays(item)

          selectors = os.environ.get("SELECTORS", "")
          wanted = []
          for part in selectors.split(","):
              p = parse_selector(part)
              if p:
                  wanted.append(p)

          if not wanted:
              print("No valid resource selectors.", file=sys.stderr)
              sys.exit(1)

          with open("report.json", encoding="utf-8") as f:
              data = json.load(f)

          kept = []
          seen = set()

          for arr in find_result_arrays(data):
              for item in arr:
                  if not isinstance(item, dict):
                      continue
                  t = resource_tuple(item)
                  if not t:
                      continue
                  if t in wanted and t not in seen:
                      kept.append(item)
                      seen.add(t)

          out = {"selectedResources": [f"{k}/{ns}/{n}" for k, ns, n in wanted], "items": kept}
          if not kept:
              out["note"] = (
                  "No items matched structured fields (resource.metadata). "
                  "Paste a sample of report.json to align the filter, or rely on full report below."
              )
              out["fullReport"] = data

          with open("report-filtered.json", "w", encoding="utf-8") as f:
              json.dump(out, f, indent=2)

          print("Wrote report-filtered.json; matched items:", len(kept))
          PY

      - name: Generate PolicyException YAML with nctl ai
        working-directory: ${{ inputs.chart_path }}
        env:
          EXCEPTION_DIR: ${{ inputs.exception_dir }}
        run: |
          set -euo pipefail
          mkdir -p "${EXCEPTION_DIR}"
          cat > nctl-ai-prompt.txt << EOF
          Based on the violations in report-filtered.json in the current directory, generate Kyverno PolicyException YAML manifests
          only for the Kubernetes resources implied by selectedResources and the items list. Use valid apiVersion/kind for PolicyException
          (e.g. kyverno.io/v2beta1 PolicyException as appropriate for the cluster/policy version).
          Write one YAML file per distinct resource under this directory: ${EXCEPTION_DIR}/
          If report-filtered.json contains a "note" and empty items, infer from fullReport only for the selected resource names/kinds.
          EOF
          nctl ai --new-session --allowed-dirs "$(pwd)" --prompt "$(cat nctl-ai-prompt.txt)"

      - name: Upload PolicyException artifacts
        uses: actions/upload-artifact@v4
        with:
          name: policyexceptions-${{ github.run_id }}
          path: ${{ inputs.chart_path }}/${{ inputs.exception_dir }}
          if-no-files-found: warn

      - name: Job summary
        working-directory: ${{ inputs.chart_path }}
        if: always()
        run: |
          {
            echo "## PolicyException generation"
            echo ""
            echo "Selectors: \`${{ inputs.resources }}\`"
            echo "Output dir: \`${{ inputs.exception_dir }}\`"
            echo "Download the **policyexceptions-${{ github.run_id }}** artifact from this run."
            echo ""
          } >> "$GITHUB_STEP_SUMMARY"
          if [[ -d "${{ inputs.exception_dir }}" ]]; then
            echo "### Files" >> "$GITHUB_STEP_SUMMARY"
            find "${{ inputs.exception_dir }}" -type f \( -name '*.yaml' -o -name '*.yml' \) 2>/dev/null | head -50 >> "$GITHUB_STEP_SUMMARY" || true
          fi
