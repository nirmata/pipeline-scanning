# Option A: Scan Helm chart on every PR; publish violations to job summary, artifacts, and PR comment.
# When violations exist, nctl scan typically exits with code 1 — that means "findings present", not a crash.
#
# Required repository secrets:
#   NIRMATA_URL   — e.g. https://www.nirmata.io
#   NIRMATA_TOKEN — API token
# Optional:
#   NIRMATA_USERID — if your nctl version requires login with userid (email)
#
# Repository variable (recommended):
#   HELM_CHART_PATH — directory that contains Chart.yaml (e.g. charts/myapp). If unset, defaults to ".".
#   Using "." scans the whole repo; any large *.zip (e.g. nctl.zip) can trigger:
#   Error: chart file "nctl.zip" is larger than the maximum file size 5242880

name: nctl Helm policy scan (PR)

on:
  pull_request:
    branches: [exceptions-in-pipelines]
    # Uncomment to limit to chart paths:
    # paths:
    #   - 'charts/**'
    #   - '.github/workflows/nctl-helm-scan-pr.yml'

concurrency:
  group: nctl-helm-scan-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  pull-requests: write

env:
  NIRMATA_URL: ${{ secrets.NIRMATA_URL }}
  NIRMATA_TOKEN: ${{ secrets.NIRMATA_TOKEN }}
  POLICY_SETS: pss-baseline,pss-restricted
  # Set in: Settings → Secrets and variables → Actions → Variables → HELM_CHART_PATH
  CHART_PATH: ${{ vars.HELM_CHART_PATH != '' && vars.HELM_CHART_PATH || '.' }}
  # Output folder for nctl ai–generated PolicyException YAML (optional override)
  POLICYEXCEPTION_DIR: ${{ vars.POLICYEXCEPTION_DIR != '' && vars.POLICYEXCEPTION_DIR || 'policyexceptions' }}

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # Full CLI (includes `nctl ai`). The marketplace action pinned an older build without `ai`.
      # See: https://downloads.nirmata.io/nctl/downloads/
      - name: Install nctl
        run: |
          set -euo pipefail
          curl -fsSL https://downloads.nirmata.io/nctl/install.sh | bash
          NCTL_BIN="$(command -v nctl)"
          echo "$(dirname "${NCTL_BIN}")" >> "${GITHUB_PATH}"
          nctl version
          nctl ai --help >/dev/null

      - name: Authenticate nctl (optional)
        env:
          NIRMATA_USERID: ${{ secrets.NIRMATA_USERID }}
        run: |
          set -euo pipefail
          if [ -n "${NIRMATA_USERID:-}" ]; then
            nctl login --url "${NIRMATA_URL}" --userid "${NIRMATA_USERID}" --token "${NIRMATA_TOKEN}"
          fi

      # Scanning the whole repo (-r .) makes nctl treat *.zip files as chart packages; large zips fail with a 5MB limit.
      # Prefer HELM_CHART_PATH pointing at the folder that contains Chart.yaml.
      - name: Prepare scan path
        run: |
          set -euo pipefail
          echo "CHART_PATH=${CHART_PATH}"
          if [[ ! -d "${CHART_PATH}" ]]; then
            echo "::error::HELM_CHART_PATH is not a directory: ${CHART_PATH}"
            exit 1
          fi
          if [[ "${CHART_PATH}" == "." ]] && [[ -f nctl.zip ]]; then
            echo "::warning::Removing nctl.zip at repository root so the scan can run (exceeds nctl's 5MB chart package limit). Prefer setting repo variable HELM_CHART_PATH to your chart directory."
            rm -f nctl.zip
          fi

      - name: Scan Helm chart
        id: scan
        continue-on-error: true
        run: |
          set -euo pipefail
          set -o pipefail
          nctl scan helm -r "${CHART_PATH}" --policy-sets "${POLICY_SETS}" -o json | tee report.json

      - name: Summarize report for Actions UI
        if: always()
        run: |
          set -euo pipefail
          {
            echo "## nctl Helm policy scan"
            echo ""
            echo "| Field | Value |"
            echo "| --- | --- |"
            echo "| Policy sets | \`${POLICY_SETS}\` |"
            echo "| Commit | \`${{ github.sha }}\` |"
            echo "| Workflow | [$GITHUB_RUN_ID]($GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID) |"
            echo ""
          } >> "$GITHUB_STEP_SUMMARY"

          if [[ ! -f report.json ]]; then
            echo "_report.json was not produced._" >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi

          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "> **Note:** If the scan step shows exit code **1**, that usually means **policy violations were found** (expected for a failing policy result). It does not mean the scanner failed to produce \`report.json\`." >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"

          # Human-readable excerpt (tune jq once you confirm your report schema)
          echo "### Report excerpt" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo '```json' >> "$GITHUB_STEP_SUMMARY"
          jq -c '.' report.json 2>/dev/null | head -c 24000 >> "$GITHUB_STEP_SUMMARY" || cat report.json | head -c 24000 >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo '```' >> "$GITHUB_STEP_SUMMARY"

      - name: Upload scan report
        if: always() && hashFiles('report.json') != ''
        uses: actions/upload-artifact@v4
        with:
          name: helm-scan-report-${{ github.run_id }}
          path: report.json
          if-no-files-found: warn

      - name: Generate PolicyException YAML with nctl ai
        id: policy_exceptions
        if: hashFiles('report.json') != ''
        continue-on-error: true
        env:
          POLICYEXCEPTION_DIR: ${{ env.POLICYEXCEPTION_DIR }}
        run: |
          set -euo pipefail
          mkdir -p "${POLICYEXCEPTION_DIR}"
          cat > nctl-ai-policyexceptions-prompt.txt << EOF
          Read the Helm policy scan results in report.json in the current working directory.

          Based on the violations in report.json, generate Kyverno PolicyException YAML manifests for each individual Kubernetes resource that has violations (one PolicyException per resource or per logical group as appropriate).

          Use a valid PolicyException apiVersion/kind (e.g. kyverno.io/v2beta1 PolicyException) appropriate for modern Kyverno.

          Write all generated YAML files under the directory: ${POLICYEXCEPTION_DIR}/
          Use clear file names (e.g. including resource kind and name).
          EOF
          set +e
          nctl ai --new-session \
            --allowed-dirs "$(pwd)" \
            --prompt "$(cat nctl-ai-policyexceptions-prompt.txt)" \
            --skip-permission-checks \
            --force
          ai_exit=$?
          set -e
          if [[ "${ai_exit}" -eq 0 ]]; then
            echo "ai_success=true" >> "$GITHUB_OUTPUT"
          else
            echo "ai_success=false" >> "$GITHUB_OUTPUT"
            echo "::warning::nctl ai exited with ${ai_exit}; see log above."
          fi
          exit 0

      - name: Upload PolicyException YAML artifact
        if: always() && steps.policy_exceptions.outputs.ai_success == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: policyexceptions-${{ github.run_id }}
          path: ${{ env.POLICYEXCEPTION_DIR }}
          if-no-files-found: warn

      - name: PolicyException summary
        if: always()
        run: |
          {
            echo ""
            echo "### PolicyException generation (nctl ai)"
            echo ""
          } >> "$GITHUB_STEP_SUMMARY"
          if [[ "${{ steps.policy_exceptions.outputs.ai_success }}" == "true" ]]; then
            echo "Generated YAML uploaded as artifact **policyexceptions-${{ github.run_id }}**." >> "$GITHUB_STEP_SUMMARY"
          elif [[ "${{ steps.policy_exceptions.outcome }}" == "skipped" ]]; then
            echo "_Skipped (no report.json)._ " >> "$GITHUB_STEP_SUMMARY"
          else
            echo "_Generation did not succeed — see the **Generate PolicyException YAML with nctl ai** step log._" >> "$GITHUB_STEP_SUMMARY"
          fi

      - name: Comment on PR with summary
        if: always() && github.event_name == 'pull_request'
        uses: actions/github-script@v7
        env:
          POLICY_SETS: ${{ env.POLICY_SETS }}
          AI_SUCCESS: ${{ steps.policy_exceptions.outputs.ai_success }}
        with:
          script: |
            const fs = require('fs');
            const path = 'report.json';
            let body = '## nctl Helm policy scan\n\n';
            body += `Policy sets: \`${process.env.POLICY_SETS}\`\n`;
            body += `[Workflow run (summary + artifacts)](${process.env.GITHUB_SERVER_URL}/${process.env.GITHUB_REPOSITORY}/actions/runs/${process.env.GITHUB_RUN_ID})\n\n`;
            body += '_If the scan step exits with **1**, that usually means **violations were found** (not a broken scan), as long as `report.json` was produced._\n\n';
            if (process.env.AI_SUCCESS === 'true') {
              body += `**PolicyException YAML:** download artifact **policyexceptions-${process.env.GITHUB_RUN_ID}** from this run.\n\n`;
            } else if (process.env.AI_SUCCESS === 'false') {
              body += '_PolicyException generation (nctl ai) did not complete successfully — see the workflow log._\n\n';
            }

            try {
              const raw = fs.readFileSync(path, 'utf8');
              const preview = raw.length > 12000 ? raw.slice(0, 12000) + '\n\n…(truncated)' : raw;
              body += '<details><summary>Report JSON (click to expand)</summary>\n\n';
              body += '```json\n' + preview + '\n```\n\n</details>\n';
            } catch (e) {
              body += '_Could not read report.json._\n';
            }

            const { data: comments } = await github.rest.issues.listComments({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
            });

            const marker = '<!-- nctl-helm-scan-bot -->';
            const existing = comments.find(c => c.body && c.body.includes(marker));

            const payload = marker + '\n\n' + body;

            if (existing) {
              await github.rest.issues.updateComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                comment_id: existing.id,
                body: payload,
              });
            } else {
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.issue.number,
                body: payload,
              });
            }

      # Uncomment to fail the PR when the scan fails (violations / nctl non-zero exit)
      # - name: Enforce scan success
      #   if: steps.scan.outcome != 'success'
      #   run: exit 1
